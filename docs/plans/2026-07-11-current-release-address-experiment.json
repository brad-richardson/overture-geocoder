    "count_basis": "Counts are raw, unweighted sample counts. Recorded candidate populations come from bbox-prefiltered, exact-geometry-verified candidates and cannot observe missing or spatially discordant bbox rows; no global design-weighted estimate is reported.",
    "current_harness_query_sql": "WITH configured_boxes(\n            sample_box, sample_stratum, expected_country,\n            xmin, ymin, xmax, ymax\n        ) AS (VALUES\n                ('manhattan', 'high-rise', 'US', -74.01, 40.7, -73.99, 40.72),\n                ('singapore-cbd', 'high-rise', 'SG', 103.845, 1.275, 103.865, 1.295),\n                ('melbourne-cbd', 'high-rise', 'AU', 144.95, -37.825, 144.98, -37.805),\n                ('paris', 'dense', 'FR', 2.335, 48.85, 2.355, 48.87),\n                ('mexico-city', 'dense', 'MX', -99.145, 19.42, -99.125, 19.44),\n                ('sao-paulo', 'dense', 'BR', -46.655, -23.56, -46.635, -23.54),\n                ('cambridge-ma', 'suburban', 'US', -71.16, 42.36, -71.13, 42.39),\n                ('parramatta', 'suburban', 'AU', 150.99, -33.83, 151.02, -33.8),\n                ('auckland', 'suburban', 'NZ', 174.73, -36.9, 174.77, -36.86),\n                ('rural-kansas', 'rural', 'US', -97.05, 38.98, -96.95, 39.08),\n                ('rural-france', 'rural', 'FR', 1.8, 46.75, 1.9, 46.85),\n                ('rural-kwazulu-natal', 'rural', 'ZA', 30.15, -29.85, 30.25, -29.75)\n        ), bbox_pruned AS MATERIALIZED (\n            SELECT *\n            FROM read_parquet('s3://overturemaps-us-west-2/release/2026-06-17.0/theme=addresses/type=address/*', hive_partitioning = true)\n            WHERE ((bbox IS NOT NULL\n              AND bbox.xmax >= -74.01\n              AND bbox.xmin <= -73.99\n              AND bbox.ymax >= 40.7\n              AND bbox.ymin <= 40.72)\n                OR (bbox IS NOT NULL\n              AND bbox.xmax >= 103.845\n              AND bbox.xmin <= 103.865\n              AND bbox.ymax >= 1.275\n              AND bbox.ymin <= 1.295)\n                OR (bbox IS NOT NULL\n              AND bbox.xmax >= 144.95\n              AND bbox.xmin <= 144.98\n              AND bbox.ymax >= -37.825\n              AND bbox.ymin <= -37.805)\n                OR (bbox IS NOT NULL\n              AND bbox.xmax >= 2.335\n              AND bbox.xmin <= 2.355\n              AND bbox.ymax >= 48.85\n              AND bbox.ymin <= 48.87)\n                OR (bbox IS NOT NULL\n              AND bbox.xmax >= -99.145\n              AND bbox.xmin <= -99.125\n              AND bbox.ymax >= 19.42\n              AND bbox.ymin <= 19.44)\n                OR (bbox IS NOT NULL\n              AND bbox.xmax >= -46.655\n              AND bbox.xmin <= -46.635\n              AND bbox.ymax >= -23.56\n              AND bbox.ymin <= -23.54)\n                OR (bbox IS NOT NULL\n              AND bbox.xmax >= -71.16\n              AND bbox.xmin <= -71.13\n              AND bbox.ymax >= 42.36\n              AND bbox.ymin <= 42.39)\n                OR (bbox IS NOT NULL\n              AND bbox.xmax >= 150.99\n              AND bbox.xmin <= 151.02\n              AND bbox.ymax >= -33.83\n              AND bbox.ymin <= -33.8)\n                OR (bbox IS NOT NULL\n              AND bbox.xmax >= 174.73\n              AND bbox.xmin <= 174.77\n              AND bbox.ymax >= -36.9\n              AND bbox.ymin <= -36.86)\n                OR (bbox IS NOT NULL\n              AND bbox.xmax >= -97.05\n              AND bbox.xmin <= -96.95\n              AND bbox.ymax >= 38.98\n              AND bbox.ymin <= 39.08)\n                OR (bbox IS NOT NULL\n              AND bbox.xmax >= 1.8\n              AND bbox.xmin <= 1.9\n              AND bbox.ymax >= 46.75\n              AND bbox.ymin <= 46.85)\n                OR (bbox IS NOT NULL\n              AND bbox.xmax >= 30.15\n              AND bbox.xmin <= 30.25\n              AND bbox.ymax >= -29.85\n              AND bbox.ymin <= -29.75))\n        ), matched AS (\n            SELECT address.*, box.*\n            FROM bbox_pruned address\n            JOIN configured_boxes box ON\n                address.geometry IS NOT NULL\n                AND ST_GeometryType(address.geometry) = 'POINT'\n                AND ST_X(address.geometry) >= box.xmin\n                AND ST_X(address.geometry) <= box.xmax\n                AND ST_Y(address.geometry) >= box.ymin\n                AND ST_Y(address.geometry) <= box.ymax\n        ), ranked AS (\n            SELECT\n                id AS overture_id,\n                '2026-06-17.0' AS overture_release,\n                'v1.17.0' AS overture_schema_version,\n                version,\n                ST_X(geometry) AS lon,\n                ST_Y(geometry) AS lat,\n                bbox.xmin AS bbox_xmin,\n                bbox.ymin AS bbox_ymin,\n                bbox.xmax AS bbox_xmax,\n                bbox.ymax AS bbox_ymax,\n                FALSE AS bbox_missing,\n                NOT (\n                    ST_X(geometry) >= bbox.xmin AND ST_X(geometry) <= bbox.xmax\n                    AND ST_Y(geometry) >= bbox.ymin AND ST_Y(geometry) <= bbox.ymax\n                ) AS bbox_geometry_discordant,\n                country, number, street, unit, postcode, postal_city,\n                address_levels,\n                list_extract(address_levels, 1).value AS state,\n                list_extract(address_levels, -1).value AS locality,\n                sources,\n                list_filter(sources, lambda source: source.property = '') AS root_sources,\n                list_count(list_filter(sources, lambda source: source.property = ''))\n                    AS root_source_count,\n                sample_box, sample_stratum, expected_country,\n                'bbox-prefiltered-geometry-verified' AS sample_selection_contract,\n                COUNT(*) OVER (PARTITION BY sample_box)::BIGINT AS bbox_population,\n                ROW_NUMBER() OVER (\n                    PARTITION BY sample_box ORDER BY md5(id)\n                ) AS deterministic_sample_rank\n            FROM matched\n        )\n        SELECT * FROM ranked\n        WHERE deterministic_sample_rank <= 2000\n        ORDER BY sample_box, deterministic_sample_rank",
